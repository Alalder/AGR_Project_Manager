<Window x:Class="AGR_Project_Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:AGR_Project_Manager.Converters"
        mc:Ignorable="d"
        Title="AGR Project Manager"
        MinHeight="600" MinWidth="1200"
        Height="750" Width="1400"
        Background="{DynamicResource BackgroundPrimary}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Конвертеры -->
        <converters:PathToImageConverter x:Key="PathToImageConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:ResolutionToBrushConverter x:Key="ResolutionToBrushConverter"/>
        <converters:ResolutionToVisibilityConverter x:Key="ResolutionToVisibilityConverter"/>

        <Storyboard x:Key="ShowUtilitiesPanelStoryboard">
            <DoubleAnimation Storyboard.TargetName="UtilitiesPanelScale" Storyboard.TargetProperty="ScaleY"
                      From="0" To="1" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="UtilitiesSidePanel" Storyboard.TargetProperty="Opacity"
                      From="0" To="1" Duration="0:0:0.15"/>
        </Storyboard>

        <Storyboard x:Key="HideUtilitiesPanelStoryboard">
            <DoubleAnimation Storyboard.TargetName="UtilitiesPanelScale" Storyboard.TargetProperty="ScaleY"
                      From="1" To="0" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="UtilitiesSidePanel" Storyboard.TargetProperty="Opacity"
                      From="1" To="0" Duration="0:0:0.12"/>
        </Storyboard>

        <ContextMenu x:Key="ProjectContextMenu">
            <MenuItem Header="✏️ Изменить" Click="EditProject_Click"
              Tag="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=PlacementTarget.DataContext.IsArchived, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="📋 Дублировать" Click="CloneProject_Click"
              Tag="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=PlacementTarget.DataContext.IsArchived, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="📦 В архив" Click="ArchiveProject_Click"
              Tag="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=PlacementTarget.DataContext.IsArchived, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="♻️ Восстановить" Click="RestoreProject_Click"
              Tag="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=PlacementTarget.DataContext.IsArchived, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="❌ Удалить навсегда" Click="DeleteProject_Click"
              Tag="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=PlacementTarget.DataContext.IsArchived, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
        </ContextMenu>
        <Style x:Key="ProjectListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource ListItemBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ContextMenu" Value="{StaticResource ProjectContextMenu}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        BorderThickness="3,0,3,0"
                        BorderBrush="Transparent"
                        CornerRadius="0,4,4,0">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListItemBackgroundHover}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BorderSecondary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListItemBackgroundSelected}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль вкладки Проекты/Архив -->
        <Style x:Key="DarkTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="{DynamicResource BackgroundTertiary}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondary}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Margin="0,0,2,0" CornerRadius="4,4,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Полная замена шаблона TabControl — убирает системную белую рамку контента -->
        <Style x:Key="DarkTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent"/>
                            <Border Grid.Row="1" Background="{DynamicResource BackgroundTertiary}"
                            BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="0,4,4,4">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Глобальные стили ContextMenu/MenuItem/Separator под тёмную тему -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource BackgroundTertiary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource BorderPrimary}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>

        <DataTemplate x:Key="ProjectItemTemplate">
            <StackPanel Margin="2">
                <TextBlock Text="{Binding Name}" 
                   Foreground="{DynamicResource ForegroundPrimary}" 
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Description}" 
                   Foreground="{DynamicResource ForegroundTertiary}" 
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Для TabControl, где реальный контент вкладок не используется (переключение обрабатывается в code-behind) -->
        <Style x:Key="HeaderOnlyTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <TabPanel IsItemsHost="True" Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ProjectsPanelColumn" Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== ЛЕВАЯ ПАНЕЛЬ ===== -->
        <Border x:Name="ProjectsPanelExpanded" Grid.Column="0" Background="{DynamicResource BackgroundSecondary}"
        BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="10,10,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="NewProjectBtn" 
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    Click="NewProjectBtn_Click">
                        ✚ Новый проект
                    </Button>
                    <Button Grid.Column="1" Content="◀" Width="36" Height="36" Padding="0"
                            Style="{StaticResource DisableableButtonStyle}"
                            Margin="6,0,0,0"
                            FontSize="12"
                            Click="ToggleProjectsPanel_Click"
                            ToolTip="Свернуть панель"/>
                </Grid>

                <TabControl Grid.Row="1" Margin="10"
            Style="{StaticResource DarkTabControlStyle}"
            ItemContainerStyle="{StaticResource DarkTabItemStyle}">
                    <TabItem Header="Проекты">
                        <ListBox x:Name="ActiveProjectsList"
                         Background="{DynamicResource BackgroundTertiary}"
                         BorderBrush="{DynamicResource BorderPrimary}"
                         BorderThickness="1"
                         ItemContainerStyle="{StaticResource ProjectListItemStyle}"
                         ItemTemplate="{StaticResource ProjectItemTemplate}"
                         SelectionChanged="ProjectsList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </TabItem>
                    <TabItem Header="Архив">
                        <ListBox x:Name="ArchivedProjectsList"
                         Background="{DynamicResource BackgroundTertiary}"
                         BorderBrush="{DynamicResource BorderPrimary}"
                         BorderThickness="1"
                         ItemContainerStyle="{StaticResource ProjectListItemStyle}"
                         ItemTemplate="{StaticResource ProjectItemTemplate}"
                         SelectionChanged="ProjectsList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <Border x:Name="ProjectsPanelCollapsedBar" Grid.Column="0" Background="{DynamicResource BackgroundSecondary}" 
        BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,0,1,0" Visibility="Collapsed">
            <Button Content="▶" Width="36" Height="36" Padding="0" 
                    Margin="4,10,0,0" VerticalAlignment="Top"
                    Style="{StaticResource DisableableButtonStyle}"
                    FontSize="12"
                    Click="ToggleProjectsPanel_Click"
                    ToolTip="Развернуть панель проектов"/>
        </Border>

        <!-- ===== ПРАВАЯ ПАНЕЛЬ ===== -->
        <Border Grid.Column="1" Background="{DynamicResource BackgroundPrimary}">
            <Grid>
                <!-- Заглушка -->
                <TextBlock x:Name="PlaceholderText"
                           Text="Выберите проект или создайте новый" 
                           Foreground="{DynamicResource ForegroundSecondary}" 
                           FontSize="16" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Панель проекта -->
                <Grid x:Name="ProjectPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок проекта -->
                    <Border Grid.Row="0" Background="{DynamicResource BackgroundSecondary}" 
                    Margin="10,10,10,0" CornerRadius="8" Padding="15,10">
                        <StackPanel>
                            <TextBlock x:Name="ProjectTitle" FontSize="20" FontWeight="Bold" 
                   Foreground="{DynamicResource ForegroundPrimary}"/>
                            <TextBlock x:Name="ProjectDescription" 
                   Foreground="{DynamicResource ForegroundTertiary}" 
                   FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Вкладки моделей -->
                    <Grid Grid.Row="1" Margin="10,10,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TabControl x:Name="ModelsTabControl" Grid.Column="0" 
                                    Style="{StaticResource HeaderOnlyTabControlStyle}"
                                    SelectionChanged="ModelsTabControl_SelectionChanged">
                            <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem">
                                <Setter Property="Background" Value="{DynamicResource BackgroundTertiary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondary}"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="Border" 
                                                    Background="{TemplateBinding Background}" 
                                                    Padding="{TemplateBinding Padding}" 
                                                    Margin="0,0,2,0"
                                                    CornerRadius="4,4,0,0">
                                                    <Grid>
                                                        <StackPanel x:Name="NormalContent" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" 
                                                               Margin="0,0,5,0"/>
                                                    <Button Content="✏️" FontSize="10" Background="Transparent" 
                                                            Foreground="{DynamicResource ForegroundTertiary}" 
                                                            BorderThickness="0" Margin="2,0"
                                                            ToolTip="Переименовать" Tag="{Binding}"
                                                            Click="RenameModel_Click"/>
                                                    <Button Content="📋" FontSize="10" Background="Transparent" 
                                                            Foreground="{DynamicResource ForegroundTertiary}" 
                                                            BorderThickness="0" Margin="2,0"
                                                            ToolTip="Дублировать" Tag="{Binding}"
                                                            Click="DuplicateModel_Click"/>
                                                    <Button Content="❌" FontSize="10" Background="Transparent" 
                                                            Foreground="{DynamicResource DangerForeground}" 
                                                            BorderThickness="0" Margin="2,0"
                                                            ToolTip="Удалить" Tag="{Binding}"
                                                            Click="RemoveModel_Click"/>
                                                </StackPanel>
                                                        <TextBlock x:Name="AddTabContent" Text="➕" FontWeight="Bold" FontSize="13"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="Collapsed"/> 
                                                    </Grid>
                                                </Border>
                                            <ControlTemplate.Triggers>
                                                    <Trigger Property="Tag" Value="ADD_MODEL_TAB">
                                                        <Setter TargetName="NormalContent" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="AddTabContent" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                    <Trigger Property="Tag" Value="ADD_MODEL_TAB">
                                                        <Setter TargetName="NormalContent" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="AddTabContent" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentPrimary}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" 
                                                            Value="{DynamicResource SelectionBackground}"/>
                                                    <Setter Property="Foreground" 
                                                            Value="{DynamicResource ForegroundPrimary}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" 
                                                            Value="{DynamicResource HoverBackground}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.ItemContainerStyle>
                        </TabControl>
                        
                    </Grid>

                    <!-- Панель UDIM -->
                    <Border Grid.Row="2" Background="{DynamicResource BackgroundSecondary}" 
                        Margin="10,4,10,10" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Кнопки управления рядами -->
                            <Border Grid.Row="0" Background="{DynamicResource BackgroundQuaternary}" 
                                    Margin="0" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Верхняя строка -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <Button Content="➕ Добавить ряд" 
        Style="{StaticResource TintedOutlineButtonStyle}"
        Foreground="{DynamicResource TextureErmAccent}"
        BorderBrush="{DynamicResource TextureErm}"
        Margin="0,0,10,0" Click="AddUdimRow_Click"/>
                                        <Button Content="➖ Удалить верхний ряд" 
        Style="{StaticResource TintedOutlineButtonStyle}"
        Foreground="{DynamicResource Resolution1K}"
        BorderBrush="{DynamicResource Resolution1K}"
        Margin="0,0,10,0" Click="RemoveUdimRow_Click"/>
                                        <Separator Width="1" Background="{DynamicResource BorderSecondary}" Margin="10,0"/>
                                        <Button x:Name="CopyTileBtn" Content="📋 Копировать" 
        Style="{StaticResource TintedOutlineButtonStyle}"
        Foreground="{DynamicResource TextureNormalAccent}"
        BorderBrush="{DynamicResource TextureNormal}"
        Margin="0,0,5,0" Click="CopyTile_Click"/>
                                        <Button x:Name="PasteTileBtn" Content="📥 Вставить" 
        Style="{StaticResource TintedOutlineButtonStyle}"
        Foreground="{DynamicResource TextureNormalAccent}"
        BorderBrush="{DynamicResource TextureNormal}"
        Margin="0,0,5,0" Click="PasteTile_Click"/>
                                        <Button x:Name="ClearTileBtn" Content="🗑️ Очистить" 
            Style="{StaticResource DangerActionButtonStyle}"
            Click="ClearTile_Click"/>
</StackPanel>

                                    <!-- Строка пресетов -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="💾 Пресеты:" 
                                                   Foreground="{DynamicResource ForegroundTertiary}" 
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button Content="➕ Сохранить как пресет" 
        Style="{StaticResource PrimaryActionButtonStyle}"
        Margin="0,0,10,0" Click="SavePreset_Click"/>
<ComboBox x:Name="PresetComboBox" 
          Width="200" 
          Margin="0,0,10,0"
          DisplayMemberPath="Name"
          SelectionChanged="PresetComboBox_SelectionChanged"/>
                                        <Button x:Name="ApplyPresetBtn" Content="📥 Применить" 
        Style="{StaticResource TintedOutlineButtonStyle}"
        Foreground="{DynamicResource TextureErmAccent}"
        BorderBrush="{DynamicResource TextureErm}"
        Margin="0,0,5,0" Click="ApplyPreset_Click"/>
                                        <Button x:Name="DeletePresetBtn" Content="🗑️" 
        Style="{StaticResource DangerActionButtonStyle}"
        Padding="8,6" ToolTip="Удалить пресет" 
        IsEnabled="False" Click="DeletePreset_Click"/>
                                    </StackPanel>

                                    <!-- Нижняя строка - шаблон имени файла -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="📄 Шаблон имени:" 
                                                   Foreground="{DynamicResource ForegroundTertiary}" 
                                                   FontSize="11" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <Border Background="{DynamicResource BackgroundPrimary}" 
                                                CornerRadius="4" 
                                                Padding="10,4">
                                            <TextBlock x:Name="FileNameTemplateText" 
                                                       Text="T_[Проект]_[Тип]_1.[UDIM].png" 
                                                       Foreground="{DynamicResource CodeText}" 
                                                       FontSize="11" 
                                                       FontFamily="Consolas"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Сетка UDIM -->
                            <!-- Сетка UDIM с адаптивным размером -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
              HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="UdimGrid" Margin="10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Ряд UDIM -->
                                            <ItemsControl ItemsSource="{Binding}" Margin="0,0,0,8">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" Columns="10"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- Один UDIM тайл -->
                                                        <Border Background="{DynamicResource BackgroundTertiary}" 
                                                        Margin="3" 
                                                        CornerRadius="6"
                                                        MouseLeftButtonDown="UdimTile_MouseDown"
                                                        Cursor="Hand"
                                                        Focusable="False">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                </Style>
                                                            </Border.Style>

                                                            <Grid>
                                                                <!-- Фоновое изображение Diffuse -->
                                                                <Image Source="{Binding DiffusePath, Converter={StaticResource PathToImageConverter}}"
               Stretch="UniformToFill"
               Opacity="0.5"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>

                                                                <!-- Контент -->
                                                                <Grid Margin="4">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="*"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>

                                                                    <!-- Название материала (сверху) - УВЕЛИЧЕННОЕ -->
                                                                    <Border Grid.Row="0" 
        CornerRadius="3" 
        Padding="8,4"
        Margin="0,0,0,4"
        HorizontalAlignment="Center"
        Cursor="Hand"
        MouseLeftButtonDown="RenameTile_Click">
                                                                        <Border.Background>
                                                                            <SolidColorBrush Color="{Binding Source={StaticResource BackgroundPrimary}, Path=Color}" Opacity="0.7"/>
                                                                        </Border.Background>
                                                                        <TextBlock Text="{Binding DisplayName}" 
               Foreground="{DynamicResource ForegroundPrimary}" 
               FontSize="12"
               FontWeight="SemiBold"
               TextWrapping="Wrap"
               TextAlignment="Center"
               HorizontalAlignment="Center"
               ToolTip="Кликните для переименования"/>
                                                                    </Border>

                                                                    <!-- Пустое пространство для превью текстуры -->
                                                                    <Grid Grid.Row="1"/>

                                                                    <!-- Три зоны текстур с индикаторами разрешения -->
                                                                    <Grid Grid.Row="2" Margin="0,4,0,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- ===== DIFFUSE ===== -->
                                                                        <StackPanel Grid.Column="0" Margin="1">
                                                                            <!-- Кнопка D -->
                                                                            <Border Tag="Diffuse"
                                                                                    CornerRadius="3"
                                                                                    Padding="4,2"
                                                                                    BorderThickness="2,0,0,0"
                                                                                    Cursor="Hand"
                                                                                    MouseLeftButtonDown="TextureZone_Click"
                                                                                    ToolTip="{Binding DiffusePath}">        
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Background" Value="{DynamicResource TextureZoneEmpty}"/>
                                                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSecondary}"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding HasDiffuse}" Value="True">
                                                                                                <Setter Property="BorderBrush" Value="{DynamicResource TextureDiffuse}"/>
                                                                                            </DataTrigger>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter Property="Background" Value="{DynamicResource TextureDiffuseHover}"/>
                                                                                                <Setter Property="Opacity" Value="0.85"/>
                                                                                            </Trigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <TextBlock Text="D" 
                                                                                           FontWeight="Bold"
                                                                                           FontSize="11"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center">  
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundTertiary}"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding HasDiffuse}" Value="True">
                                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextureDiffuseAccent}"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                            </Border>

                                                                            <!-- Индикатор разрешения Diffuse -->
                                                                            <Border Margin="0,2,0,0"
                                                                                    CornerRadius="2"
                                                                                    Padding="3,1"
                                                                                    Background="{Binding DiffuseResolution, Converter={StaticResource ResolutionToBrushConverter}}"
                                                                                    Visibility="{Binding DiffuseResolution, Converter={StaticResource ResolutionToVisibilityConverter}}"
                                                                                    HorizontalAlignment="Center">
                                                                                <TextBlock Text="{Binding DiffuseResolution}"
                                                                                           Foreground="{DynamicResource ForegroundPrimary}"
                                                                                           FontSize="8"
                                                                                           FontWeight="Bold"
                                                                                           HorizontalAlignment="Center"/>
                                                                            </Border>
                                                                        </StackPanel>

                                                                        <!-- ===== ERM ===== -->
                                                                        <StackPanel Grid.Column="1" Margin="1">
                                                                            <!-- Кнопка E -->
                                                                            <Border Tag="ERM"
        CornerRadius="3"
        Padding="4,2"
        BorderThickness="2,0,0,0"
        Cursor="Hand"
        MouseLeftButtonDown="TextureZone_Click"
        ToolTip="{Binding ErmPath}">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Background" Value="{DynamicResource TextureZoneEmpty}"/>
                                                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSecondary}"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding HasErm}" Value="True">
                                                                                                <Setter Property="BorderBrush" Value="{DynamicResource TextureErm}"/>
                                                                                            </DataTrigger>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter Property="Background" Value="{DynamicResource TextureErmHover}"/>
                                                                                                <Setter Property="Opacity" Value="0.85"/>
                                                                                            </Trigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <TextBlock Text="E" 
               FontWeight="Bold"
               FontSize="11"
               HorizontalAlignment="Center"
               VerticalAlignment="Center">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundTertiary}"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding HasErm}" Value="True">
                                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextureErmAccent}"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                            </Border>

                                                                            <!-- Индикатор разрешения ERM -->
                                                                            <Border Margin="0,2,0,0"
                                                                                    CornerRadius="2"
                                                                                    Padding="3,1"
                                                                                    Background="{Binding ErmResolution, Converter={StaticResource ResolutionToBrushConverter}}"
                                                                                    Visibility="{Binding ErmResolution, Converter={StaticResource ResolutionToVisibilityConverter}}"
                                                                                    HorizontalAlignment="Center">
                                                                                <TextBlock Text="{Binding ErmResolution}"
                                                                                           Foreground="{DynamicResource ForegroundPrimary}"
                                                                                           FontSize="8"
                                                                                           FontWeight="Bold"
                                                                                           HorizontalAlignment="Center"/>
                                                                            </Border>
                                                                        </StackPanel>

                                                                        <!-- ===== NORMAL ===== -->
                                                                        <StackPanel Grid.Column="2" Margin="1">
                                                                            <!-- Кнопка N -->
                                                                            <Border Tag="Normal"
        CornerRadius="3"
        Padding="4,2"
        BorderThickness="2,0,0,0"
        Cursor="Hand"
        MouseLeftButtonDown="TextureZone_Click"
        ToolTip="{Binding NormalPath}">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Background" Value="{DynamicResource TextureZoneEmpty}"/>
                                                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSecondary}"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding HasNormal}" Value="True">
                                                                                                <Setter Property="BorderBrush" Value="{DynamicResource TextureNormal}"/>
                                                                                            </DataTrigger>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter Property="Background" Value="{DynamicResource TextureNormalHover}"/>
                                                                                                <Setter Property="Opacity" Value="0.85"/>
                                                                                            </Trigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <TextBlock Text="N" 
               FontWeight="Bold"
               FontSize="11"
               HorizontalAlignment="Center"
               VerticalAlignment="Center">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundTertiary}"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding HasNormal}" Value="True">
                                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextureNormalAccent}"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                            </Border>

                                                                            <!-- Индикатор разрешения Normal -->
                                                                            <Border Margin="0,2,0,0"
                                                                                    CornerRadius="2"
                                                                                    Padding="3,1"
                                                                                    Background="{Binding NormalResolution, Converter={StaticResource ResolutionToBrushConverter}}"
                                                                                    Visibility="{Binding NormalResolution, Converter={StaticResource ResolutionToVisibilityConverter}}"
                                                                                    HorizontalAlignment="Center">
                                                                                <TextBlock Text="{Binding NormalResolution}"
                                                                                           Foreground="{DynamicResource ForegroundPrimary}"
                                                                                           FontSize="8"
                                                                                           FontWeight="Bold"
                                                                                           HorizontalAlignment="Center"/>
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <!-- Номер UDIM (внизу) -->
                                                                    <Border Grid.Row="3" 
                                                                            Background="{DynamicResource BackgroundPrimary}" 
                                                                            CornerRadius="3" 
                                                                            Padding="6,2"
                                                                            HorizontalAlignment="Center">
                                                                        <TextBlock Text="{Binding UdimNumber}" 
                                                                                   Foreground="{DynamicResource ForegroundTertiary}" 
                                                                                   FontSize="10"
                                                                                   FontWeight="Bold"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>



                    <!-- Панель экспорта -->
                    <Border Grid.Row="3" Background="{DynamicResource BackgroundSecondary}" 
                            Padding="15" Margin="10,0,10,10" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁 Папка экспорта:" 
                                           Foreground="{DynamicResource ForegroundSecondary}" 
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="ExportPathTextBox" Width="400" 
                                         Background="{DynamicResource BackgroundTertiary}" 
                                         Foreground="{DynamicResource ForegroundPrimary}" 
                                         BorderBrush="{DynamicResource BorderPrimary}" 
                                         Padding="8,6" Margin="10,0"/>
                                <Button Content="..." 
                                        Background="{DynamicResource ButtonBackground}" 
                                        Foreground="{DynamicResource ForegroundPrimary}" 
                                        Padding="10,6" Click="BrowseExportPath_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="ExportSelectedUdimBtn"
                    Content="📤 Выбранный UDIM" 
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    Margin="0,0,10,0"
                    Click="ExportSelectedUdim_Click"
                    IsEnabled="False"/>
                                        <Button Content="📤 Все модели" 
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    Margin="0,0,10,0"
                    Click="ExportAllModels_Click"/>
                                        <Button Content="📤 Экспорт текущей модели" 
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    Click="ExportCurrentModel_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,8,10,0" Panel.ZIndex="100">
            <TextBlock Text="🎨 Тема:" Foreground="{DynamicResource ForegroundSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ThemeComboBox" Width="140" Margin="0,0,8,0"
              VerticalAlignment="Center"
              SelectionChanged="ThemeComboBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource ForegroundPrimary}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="UtilitiesToggle" Content="🔧 Утилиты" 
                    Height="32"
                    Width="260"
        Style="{StaticResource TintedOutlineButtonStyle}"
        ToolTip="Утилиты"
        Foreground="{DynamicResource TextureErmAccent}"
        BorderBrush="{DynamicResource TextureErm}"
        Click="UtilitiesToggle_Click"/>
        </StackPanel>

        <Border x:Name="UtilitiesSidePanel"
Grid.ColumnSpan="2"
HorizontalAlignment="Right" VerticalAlignment="Top"
Width="260" Panel.ZIndex="99"
Margin="0,44,10,0"
Background="{DynamicResource BackgroundTertiary}"
BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1"
CornerRadius="8"
Visibility="Collapsed"
RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="UtilitiesPanelScale" ScaleY="0"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="18" ShadowDepth="4" Direction="270"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                <StackPanel Margin="12">

                    <Button Content="🖼️ Texture Manager" Style="{StaticResource DisableableButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="10,8" FontWeight="SemiBold" Click="TextureManagerBtn_Click"/>
                    <Button Content="🎨 RAL Colors" Style="{StaticResource DisableableButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="10,8" Click="RalColorsBtn_Click"/>
                    <Button Content="🔤 Name Generator" Style="{StaticResource DisableableButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="10,8" Click="NameGeneratorBtn_Click"/>
                    <Button Content="📁 Создать папку проекта" Style="{StaticResource DisableableButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="10,8" Click="CreateFolderBtn_Click"/>
                    <Button Content="🌍 GeoJSON Generator" Style="{StaticResource DisableableButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="10,8" Click="GeoJsonBtn_Click"/>
                    <Button Content="📄 PDF → Image" Style="{StaticResource DisableableButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="10,8" Click="PdfConverterBtn_Click"/>
                    <Button Content="🌍 WGS → МСК-77" Style="{StaticResource DisableableButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="10,8" Click="CoordinateConverterBtn_Click"/>
                    <Button Content="🟢 ERM Creator" Style="{StaticResource DisableableButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="10,8" Click="ErmCreatorBtn_Click"/>
                    <Button Content="📦 Archive Builder" Style="{StaticResource DisableableButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="10,8" Click="ArchiveBuilderBtn_Click"/>

                    <Separator Background="{DynamicResource BorderPrimary}" Margin="0,4"/>

                    <Button Content="📖 Справка" Style="{StaticResource DisableableButtonStyle}" HorizontalContentAlignment="Left" Margin="0,6,0,6" Padding="10,8" Click="HelpBtn_Click"/>
                    <Button Content="📋 Актуальные требования" Style="{StaticResource DisableableButtonStyle}" HorizontalContentAlignment="Left" Padding="10,8" Click="RequirementsBtn_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</Window>