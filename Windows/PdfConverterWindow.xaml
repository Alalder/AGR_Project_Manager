<Window x:Class="AGR_Project_Manager.Windows.PdfConverterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="📄 PDF → Image Converter" 
        Height="550" Width="750"
        MinHeight="450" MinWidth="600"
        Background="{DynamicResource BackgroundPrimary}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BackgroundSecondary}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Строка 0: Выбор PDF файлов ===== -->
        <Border Grid.Row="0" Style="{StaticResource SectionBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="📄 PDF файлы:" 
                           Foreground="{DynamicResource ForegroundPrimary}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0,0,10,0"/>

                <TextBox x:Name="FolderPathTextBox" 
                         Grid.Column="1"
                         Background="{DynamicResource BackgroundTertiary}"
                         Foreground="{DynamicResource ForegroundPrimary}"
                         BorderBrush="{DynamicResource BorderPrimary}"
                         Padding="8,6"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"/>

                <Button x:Name="BrowseFilesBtn" 
                        Grid.Column="2"
                        Content="📄 Выбрать PDF..."
                        Background="{DynamicResource AccentPrimary}"
                        Foreground="{DynamicResource ForegroundPrimary}"
                        Padding="12,6"
                        Margin="8,0,0,0"
                        FontWeight="SemiBold"
                        Click="BrowseFilesBtn_Click"/>

                <Button x:Name="ClearListBtn" 
                        Grid.Column="3"
                        Content="🗑️"
                        Background="{DynamicResource ButtonBackground}"
                        Foreground="{DynamicResource ForegroundPrimary}"
                        Padding="10,6"
                        Margin="8,0,0,0"
                        ToolTip="Очистить список"
                        Click="ClearListBtn_Click"/>
            </Grid>
        </Border>

        <!-- ===== Строка 1: Настройки ===== -->
        <Border Grid.Row="1" Style="{StaticResource SectionBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- DPI -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="🎯 DPI:" 
                               Foreground="{DynamicResource ForegroundSecondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="DpiComboBox"
                              Width="80"
                              SelectedIndex="2">
                        <ComboBoxItem Content="72" Tag="72"/>
                        <ComboBoxItem Content="150" Tag="150"/>
                        <ComboBoxItem Content="300" Tag="300"/>
                        <ComboBoxItem Content="600" Tag="600"/>
                    </ComboBox>
                </StackPanel>

                <!-- Страницы -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="📑 Страницы:" 
                               Foreground="{DynamicResource ForegroundSecondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <RadioButton x:Name="AllPagesRadio" 
                                 Content="Все" 
                                 IsChecked="True"
                                 Foreground="{DynamicResource ForegroundPrimary}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"
                                 Checked="PagesRadio_Changed"/>
                    <RadioButton x:Name="RangePagesRadio" 
                                 Content="Диапазон:" 
                                 Foreground="{DynamicResource ForegroundPrimary}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,5,0"
                                 Checked="PagesRadio_Changed"/>
                    <TextBox x:Name="PageRangeTextBox"
                             Width="120"
                             Background="{DynamicResource BackgroundTertiary}"
                             Foreground="{DynamicResource ForegroundPrimary}"
                             BorderBrush="{DynamicResource BorderPrimary}"
                             Padding="6,4"
                             IsEnabled="False"
                             ToolTip="Например: 1-5, 7, 10-15"
                             Text="1-5"/>
                </StackPanel>

                <!-- Информация о сохранении -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="💾 Сохранение:" 
                               Foreground="{DynamicResource ForegroundSecondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="В подпапку рядом с PDF" 
                               Foreground="{DynamicResource ForegroundTertiary}"
                               VerticalAlignment="Center"
                               FontStyle="Italic"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Строка 2: Список PDF файлов с Drag & Drop ===== -->
        <Border Grid.Row="2" 
                Style="{StaticResource SectionBorder}" 
                Margin="0,0,0,10"
                x:Name="DropZoneBorder">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="📋 Файлы для конвертации (или перетащите сюда PDF):" 
                           Foreground="{DynamicResource ForegroundSecondary}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <!-- DataGrid -->
                <DataGrid x:Name="PdfFilesDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="{DynamicResource BackgroundTertiary}"
                          Foreground="{DynamicResource ForegroundPrimary}"
                          BorderThickness="0"
                          RowHeaderWidth="0">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource BackgroundQuaternary}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{DynamicResource BackgroundTertiary}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="📄 Имя файла" 
                                            Binding="{Binding FileName}" 
                                            Width="*"
                                            MinWidth="200"/>
                        <DataGridTextColumn Header="📑 Страниц" 
                                            Binding="{Binding PageCount}" 
                                            Width="80"/>
                        <DataGridTextColumn Header="💾 Размер" 
                                            Binding="{Binding FileSizeDisplay}" 
                                            Width="90"/>
                        <DataGridTextColumn Header="📝 Статус" 
                                            Binding="{Binding Status}" 
                                            Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Placeholder для пустого списка -->
                <Border x:Name="DropPlaceholder"
                        Grid.Row="1"
                        Background="{DynamicResource BackgroundTertiary}"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Visibility="Visible">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count, ElementName=PdfFilesDataGrid}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📄" 
                                   FontSize="48" 
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundTertiary}"/>
                        <TextBlock Text="Перетащите PDF файлы сюда" 
                                   FontSize="16"
                                   Foreground="{DynamicResource ForegroundTertiary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,5"/>
                        <TextBlock Text="или нажмите «Выбрать PDF...»" 
                                   FontSize="12"
                                   Foreground="{DynamicResource ForegroundTertiary}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Строка 3: Статистика и кнопка конвертации ===== -->
        <Border Grid.Row="3" Style="{StaticResource SectionBorder}" Margin="0,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Статистика -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📊 Всего файлов: " 
                               Foreground="{DynamicResource ForegroundSecondary}"/>
                    <TextBlock x:Name="TotalFilesText" 
                               Text="0" 
                               Foreground="{DynamicResource ForegroundPrimary}"
                               FontWeight="Bold"
                               Margin="0,0,20,0"/>

                    <TextBlock Text="📑 Страниц: " 
                               Foreground="{DynamicResource ForegroundSecondary}"/>
                    <TextBlock x:Name="TotalPagesText" 
                               Text="0" 
                               Foreground="{DynamicResource ForegroundPrimary}"
                               FontWeight="Bold"/>
                </StackPanel>

                <!-- Кнопка конвертации -->
                <Button x:Name="ConvertBtn"
                        Grid.Column="1"
                        Content="▶️ Конвертировать"
                        Background="{DynamicResource AccentPrimary}"
                        Foreground="{DynamicResource ForegroundPrimary}"
                        Padding="20,10"
                        FontWeight="Bold"
                        FontSize="14"
                        Click="ConvertBtn_Click"/>
            </Grid>
        </Border>

        <!-- ===== Строка 4: Прогресс-бар ===== -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="4" Visibility="Collapsed" Margin="0,10,0,0">
            <Grid>
                <ProgressBar x:Name="ConversionProgress" 
                             Height="25" 
                             Minimum="0" 
                             Maximum="100"/>
                <TextBlock x:Name="ProgressText" 
                           Text="0%" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundPrimary}"
                           FontWeight="SemiBold"/>
            </Grid>
            <TextBlock x:Name="ProgressStatusText" 
                       Text="Конвертация..." 
                       Foreground="{DynamicResource ForegroundSecondary}"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>