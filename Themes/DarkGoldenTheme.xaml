<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <system:String x:Key="ThemeName" xmlns:system="clr-namespace:System;assembly=mscorlib">Тёмно-золотая</system:String>

    <!-- ===== ФОНЫ (чёрные и очень тёмные) ===== -->
    <SolidColorBrush x:Key="BackgroundPrimary" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#111111"/>
    <SolidColorBrush x:Key="BackgroundTertiary" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="BackgroundQuaternary" Color="#222222"/>

    <!-- ===== КНОПКИ ===== -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#222222"/>
    <SolidColorBrush x:Key="ButtonBackgroundHover" Color="#D4A017"/>
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#151515"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#D4A017"/>

    <!-- ===== АКЦЕНТЫ (яркие жёлтые/золотые) ===== -->
    <SolidColorBrush x:Key="AccentPrimary" Color="#F5B81B"/>
    <SolidColorBrush x:Key="AccentSecondary" Color="#FFD700"/>
    <SolidColorBrush x:Key="AccentTertiary" Color="#D4A017"/>
    <SolidColorBrush x:Key="SelectionBackground" Color="#D4A017"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#3A2E00"/>

    <!-- ===== ТЕКСТ (белый и серый для контраста) ===== -->
    <SolidColorBrush x:Key="ForegroundPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ForegroundSecondary" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="ForegroundTertiary" Color="#999999"/>
    <SolidColorBrush x:Key="ForegroundQuaternary" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="ForegroundDisabled" Color="#555555"/>
    <SolidColorBrush x:Key="CodeText" Color="#FFD700"/>

    <!-- ===== ГРАНИЦЫ ===== -->
    <SolidColorBrush x:Key="BorderPrimary" Color="#333333"/>
    <SolidColorBrush x:Key="BorderSecondary" Color="#444444"/>
    <SolidColorBrush x:Key="BorderHover" Color="#D4A017"/>

    <!-- ===== СПЕЦИАЛЬНЫЕ ===== -->
    <SolidColorBrush x:Key="DangerBackground" Color="#8B0000"/>
    <SolidColorBrush x:Key="DangerForeground" Color="#FF6666"/>
    <SolidColorBrush x:Key="DangerButtonBackground" Color="#5C0000"/>

    <!-- ===== ТЕКСТУРЫ (зоны D/ERM/N) ===== -->
    <SolidColorBrush x:Key="TextureZoneEmpty" Color="#2A2A2A"/>

    <!-- Diffuse - тёмно-рыжий -->
    <SolidColorBrush x:Key="TextureDiffuse" Color="#8B5A3C"/>
    <SolidColorBrush x:Key="TextureDiffuseHover" Color="#B87A4A"/>

    <!-- ERM - оливково-жёлтый -->
    <SolidColorBrush x:Key="TextureErm" Color="#6B8E23"/>
    <SolidColorBrush x:Key="TextureErmHover" Color="#8DB83C"/>

    <!-- Normal - золотой -->
    <SolidColorBrush x:Key="TextureNormal" Color="#B8860B"/>
    <SolidColorBrush x:Key="TextureNormalHover" Color="#D4A017"/>

    <!-- Акцентные (текстовые) варианты каналов — ярче базовых, для текста поверх тёмного фона зоны -->
    <SolidColorBrush x:Key="TextureDiffuseAccent" Color="#e08a8a"/>
    <SolidColorBrush x:Key="TextureErmAccent" Color="#7fd99a"/>
    <SolidColorBrush x:Key="TextureNormalAccent" Color="#8a9ee0"/>

    <!-- ===== СПИСКИ ===== -->
    <SolidColorBrush x:Key="ListItemBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ListItemBackgroundSelected" Color="#D4A017"/>
    <SolidColorBrush x:Key="ListItemBackgroundHover" Color="#3A2E00"/>

    <!-- ===== COMBOBOX ===== -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ComboBoxItemSelected" Color="#D4A017"/>
    <SolidColorBrush x:Key="ComboBoxItemHighlighted" Color="#3A2E00"/>
    <SolidColorBrush x:Key="ComboBoxArrow" Color="#D4A017"/>

    <!-- ===== ИНФОРМАЦИОННЫЕ БЛОКИ ===== -->
    <SolidColorBrush x:Key="InfoBoxSourceBackground" Color="#1A1A00"/>
    <SolidColorBrush x:Key="InfoBoxSourceForeground" Color="#D4A017"/>

    <SolidColorBrush x:Key="InfoBoxExportBackground" Color="#1A1A00"/>
    <SolidColorBrush x:Key="InfoBoxExportForeground" Color="#FFD700"/>

    <SolidColorBrush x:Key="InfoBoxWorkBackground" Color="#001A1A"/>
    <SolidColorBrush x:Key="InfoBoxWorkForeground" Color="#D4A017"/>

    <SolidColorBrush x:Key="InfoBoxCheckBackground" Color="#1A0000"/>
    <SolidColorBrush x:Key="InfoBoxCheckForeground" Color="#FFB347"/>

    <!-- ===== ДОПОЛНИТЕЛЬНЫЕ КНОПКИ ===== -->
    <SolidColorBrush x:Key="ButtonDanger" Color="#5C0000"/>
    <SolidColorBrush x:Key="ButtonInfo" Color="#1A2A00"/>

    <!-- ===== ЦВЕТОВЫЕ КАНАЛЫ RGB ===== -->
    <SolidColorBrush x:Key="ColorChannelRed" Color="#FF6666"/>
    <SolidColorBrush x:Key="ColorChannelGreen" Color="#66FF66"/>
    <SolidColorBrush x:Key="ColorChannelBlue" Color="#6666FF"/>

    <!-- ===== СЕКЦИИ СПРАВКИ ===== -->
    <SolidColorBrush x:Key="HelpSectionProjects" Color="#6B8E23"/>
    <SolidColorBrush x:Key="HelpSectionModels" Color="#B8860B"/>
    <SolidColorBrush x:Key="HelpSectionUdim" Color="#D4A017"/>
    <SolidColorBrush x:Key="HelpSectionPresets" Color="#3A8E8E"/>
    <SolidColorBrush x:Key="HelpSectionExport" Color="#D4A017"/>
    <SolidColorBrush x:Key="HelpSectionUtilities" Color="#9A6AC9"/>
    <SolidColorBrush x:Key="HelpSectionHotkeys" Color="#6AC9A9"/>
    <SolidColorBrush x:Key="HelpSectionStorage" Color="#C9C95A"/>

    <!-- ===== БЛОКИ СПРАВКИ ===== -->
    <SolidColorBrush x:Key="HelpBoxPurple" Color="#1A001A"/>
    <SolidColorBrush x:Key="HelpBoxGreen" Color="#001A00"/>
    <SolidColorBrush x:Key="HelpBoxRed" Color="#1A0000"/>
    <SolidColorBrush x:Key="HelpBoxBlue" Color="#00001A"/>

    <!-- ===== СТАТУСНЫЕ ЦВЕТА ===== -->
    <SolidColorBrush x:Key="SuccessText" Color="#90EE90"/>

    <!-- ===== ИНДИКАТОРЫ РАЗРЕШЕНИЯ ТЕКСТУР ===== -->
    <SolidColorBrush x:Key="Resolution4K" Color="#FFD700"/>
    <SolidColorBrush x:Key="Resolution2K" Color="#D4A017"/>
    <SolidColorBrush x:Key="Resolution1K" Color="#F5A623"/>
    <SolidColorBrush x:Key="Resolution512" Color="#F5A623"/>
    <SolidColorBrush x:Key="Resolution256" Color="#FF6666"/>

</ResourceDictionary>