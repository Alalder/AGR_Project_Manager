<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <system:String x:Key="ThemeName" xmlns:system="clr-namespace:System;assembly=mscorlib">Тёмно-бирюзовая</system:String>

    <!-- ===== ФОНЫ (нейтральный серый, едва тёплый) ===== -->
    <SolidColorBrush x:Key="BackgroundPrimary" Color="#1a1c1c"/>
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#212424"/>
    <SolidColorBrush x:Key="BackgroundTertiary" Color="#2b2f2f"/>
    <SolidColorBrush x:Key="BackgroundQuaternary" Color="#333838"/>

    <!-- ===== КНОПКИ ===== -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#3a3f3f"/>
    <SolidColorBrush x:Key="ButtonBackgroundHover" Color="#4a5050"/>
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#212424"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#4a5050"/>

    <!-- ===== АКЦЕНТЫ (яркая бирюза) ===== -->
    <SolidColorBrush x:Key="AccentPrimary" Color="#14b8a6"/>
    <SolidColorBrush x:Key="AccentSecondary" Color="#5eead4"/>
    <SolidColorBrush x:Key="AccentTertiary" Color="#0d9488"/>
    <SolidColorBrush x:Key="SelectionBackground" Color="#1e3a37"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#243330"/>

    <!-- ===== ТЕКСТ ===== -->
    <SolidColorBrush x:Key="ForegroundPrimary" Color="#f5f7f7"/>
    <SolidColorBrush x:Key="ForegroundSecondary" Color="#9ca3a3"/>
    <SolidColorBrush x:Key="ForegroundTertiary" Color="#6b7272"/>
    <SolidColorBrush x:Key="ForegroundQuaternary" Color="#d1d6d6"/>
    <SolidColorBrush x:Key="ForegroundDisabled" Color="#4b5252"/>
    <SolidColorBrush x:Key="CodeText" Color="#5eead4"/>

    <!-- ===== ГРАНИЦЫ ===== -->
    <SolidColorBrush x:Key="BorderPrimary" Color="#3a3f3f"/>
    <SolidColorBrush x:Key="BorderSecondary" Color="#4a5050"/>
    <SolidColorBrush x:Key="BorderHover" Color="#6b7272"/>

    <!-- ===== СПЕЦИАЛЬНЫЕ ===== -->
    <SolidColorBrush x:Key="DangerBackground" Color="#ef4444"/>
    <SolidColorBrush x:Key="DangerForeground" Color="#f87171"/>
    <SolidColorBrush x:Key="DangerButtonBackground" Color="#7f1d1d"/>

    <!-- ===== ТЕКСТУРЫ (зоны D/ERM/N) ===== -->
    <SolidColorBrush x:Key="TextureZoneEmpty" Color="#663a3a3a"/>
    <SolidColorBrush x:Key="TextureDiffuse" Color="#8b4a4a"/>
    <SolidColorBrush x:Key="TextureDiffuseHover" Color="#a55a5a"/>
    <SolidColorBrush x:Key="TextureErm" Color="#4a7c59"/>
    <SolidColorBrush x:Key="TextureErmHover" Color="#5a9c69"/>
    <SolidColorBrush x:Key="TextureNormal" Color="#4a5a8b"/>
    <SolidColorBrush x:Key="TextureNormalHover" Color="#5a6aab"/>
    <SolidColorBrush x:Key="TextureDiffuseAccent" Color="#e08a8a"/>
    <SolidColorBrush x:Key="TextureErmAccent" Color="#7fd99a"/>
    <SolidColorBrush x:Key="TextureNormalAccent" Color="#8a9ee0"/>

    <!-- ===== СПИСКИ ===== -->
    <SolidColorBrush x:Key="ListItemBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ListItemBackgroundSelected" Color="#1e3a37"/>
    <SolidColorBrush x:Key="ListItemBackgroundHover" Color="#243330"/>

    <!-- ===== COMBOBOX ===== -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#2b2f2f"/>
    <SolidColorBrush x:Key="ComboBoxItemSelected" Color="#14b8a6"/>
    <SolidColorBrush x:Key="ComboBoxItemHighlighted" Color="#3a3f3f"/>
    <SolidColorBrush x:Key="ComboBoxArrow" Color="#9ca3a3"/>

    <!-- ===== ИНФОРМАЦИОННЫЕ БЛОКИ ===== -->
    <SolidColorBrush x:Key="InfoBoxSourceBackground" Color="#2a3a2a"/>
    <SolidColorBrush x:Key="InfoBoxSourceForeground" Color="#6a9955"/>
    <SolidColorBrush x:Key="InfoBoxExportBackground" Color="#3a3a2a"/>
    <SolidColorBrush x:Key="InfoBoxExportForeground" Color="#c9a959"/>
    <SolidColorBrush x:Key="InfoBoxWorkBackground" Color="#2a2a3a"/>
    <SolidColorBrush x:Key="InfoBoxWorkForeground" Color="#5a7ac9"/>
    <SolidColorBrush x:Key="InfoBoxCheckBackground" Color="#3a2a2a"/>
    <SolidColorBrush x:Key="InfoBoxCheckForeground" Color="#c95a5a"/>

    <!-- ===== ДОПОЛНИТЕЛЬНЫЕ КНОПКИ ===== -->
    <SolidColorBrush x:Key="ButtonDanger" Color="#7c4a4a"/>
    <SolidColorBrush x:Key="ButtonInfo" Color="#3a3a5a"/>

    <!-- ===== ЦВЕТОВЫЕ КАНАЛЫ RGB ===== -->
    <SolidColorBrush x:Key="ColorChannelRed" Color="#ff6b6b"/>
    <SolidColorBrush x:Key="ColorChannelGreen" Color="#6bff6b"/>
    <SolidColorBrush x:Key="ColorChannelBlue" Color="#6b6bff"/>

    <!-- ===== СЕКЦИИ СПРАВКИ ===== -->
    <SolidColorBrush x:Key="HelpSectionProjects" Color="#4a7c59"/>
    <SolidColorBrush x:Key="HelpSectionModels" Color="#5a7ac9"/>
    <SolidColorBrush x:Key="HelpSectionUdim" Color="#c9a959"/>
    <SolidColorBrush x:Key="HelpSectionPresets" Color="#59a9c9"/>
    <SolidColorBrush x:Key="HelpSectionExport" Color="#c95a8a"/>
    <SolidColorBrush x:Key="HelpSectionUtilities" Color="#9a6ac9"/>
    <SolidColorBrush x:Key="HelpSectionHotkeys" Color="#6ac9a9"/>
    <SolidColorBrush x:Key="HelpSectionStorage" Color="#c9c959"/>

    <!-- ===== БЛОКИ СПРАВКИ ===== -->
    <SolidColorBrush x:Key="HelpBoxPurple" Color="#2a2a3a"/>
    <SolidColorBrush x:Key="HelpBoxGreen" Color="#2a3a2a"/>
    <SolidColorBrush x:Key="HelpBoxRed" Color="#3a2a2a"/>
    <SolidColorBrush x:Key="HelpBoxBlue" Color="#2a3a3a"/>

    <!-- ===== СТАТУСНЫЕ ЦВЕТА ===== -->
    <SolidColorBrush x:Key="SuccessText" Color="#90EE90"/>

    <!-- ===== ИНДИКАТОРЫ РАЗРЕШЕНИЯ ТЕКСТУР ===== -->
    <SolidColorBrush x:Key="Resolution4K" Color="#10b981"/>
    <SolidColorBrush x:Key="Resolution2K" Color="#14b8a6"/>
    <SolidColorBrush x:Key="Resolution1K" Color="#f59e0b"/>
    <SolidColorBrush x:Key="Resolution512" Color="#f59e0b"/>
    <SolidColorBrush x:Key="Resolution256" Color="#ef4444"/>

</ResourceDictionary>