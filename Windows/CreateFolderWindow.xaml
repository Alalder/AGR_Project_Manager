<Window x:Class="AGR_Project_Manager.Windows.CreateFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📁 Создать папку проекта" 
        Height="800" Width="950"
        MinHeight="750" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundPrimary}"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: Название проекта -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Название проекта" 
                       Foreground="{DynamicResource ForegroundSecondary}" 
                       FontSize="12" 
                       Margin="0,0,0,8"/>
            <TextBox x:Name="ProjectNameTextBox" 
                     Background="{DynamicResource BackgroundTertiary}" 
                     Foreground="{DynamicResource ForegroundPrimary}" 
                     BorderBrush="{DynamicResource BorderPrimary}"
                     Padding="12,10"
                     FontSize="14"
                     CaretBrush="{DynamicResource ForegroundPrimary}"/>
        </StackPanel>

        <!-- Выбор версии структуры и количество моделей -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Выбор версии структуры -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Версия структуры папок" 
                           Foreground="{DynamicResource ForegroundSecondary}" 
                           FontSize="12" 
                           Margin="0,0,0,8"/>
                <ComboBox x:Name="StructureVersionComboBox" 
                          Background="{DynamicResource BackgroundTertiary}" 
                          Foreground="{DynamicResource ForegroundPrimary}" 
                          BorderBrush="{DynamicResource BorderPrimary}"
                          Padding="12,10"
                          FontSize="14"
                          SelectionChanged="StructureVersionComboBox_SelectionChanged">
                    <ComboBoxItem Content="V1 (Старая версия)" IsSelected="True"/>
                    <ComboBoxItem Content="V2 (Новая версия)"/>
                </ComboBox>
            </StackPanel>

            <!-- Количество моделей (видимо только для V2) -->
            <StackPanel Grid.Column="2" x:Name="ModelCountPanel" Visibility="Collapsed">
                <TextBlock x:Name="ModelCountLabel" 
                           Text="Количество моделей" 
                           Foreground="{DynamicResource ForegroundSecondary}" 
                           FontSize="12" 
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ModelCountUpDown" 
                             Background="{DynamicResource BackgroundTertiary}" 
                             Foreground="{DynamicResource ForegroundPrimary}" 
                             BorderBrush="{DynamicResource BorderPrimary}"
                             Padding="12,10"
                             FontSize="14"
                             Text="1"
                             PreviewTextInput="ModelCountUpDown_PreviewTextInput"
                             CaretBrush="{DynamicResource ForegroundPrimary}"/>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <Button Content="▲" 
                                Background="{DynamicResource ButtonBackground}" 
                                Foreground="{DynamicResource ForegroundPrimary}"
                                Padding="8,0"
                                Height="18"
                                Click="ModelCountUp_Click"
                                Margin="0,0,0,1"/>
                        <Button Content="▼" 
                                Background="{DynamicResource ButtonBackground}" 
                                Foreground="{DynamicResource ForegroundPrimary}"
                                Padding="8,0"
                                Height="18"
                                Click="ModelCountDown_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Структура папок и описание -->
        <Border Grid.Row="4" 
                Background="{DynamicResource BackgroundSecondary}" 
                CornerRadius="8" 
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- Дерево папок -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📁 Структура папок" 
                               Foreground="{DynamicResource ForegroundPrimary}" 
                               FontSize="14" 
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <Border Background="{DynamicResource BackgroundPrimary}" 
                            CornerRadius="6" 
                            Padding="15">
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="FolderTreeStackPanel">
                                <TextBlock x:Name="RootFolderName" 
                                           Text="📁 [Название проекта]" 
                                           Foreground="{DynamicResource CodeText}" 
                                           FontFamily="Consolas" 
                                           FontSize="13"
                                           FontWeight="Bold"/>

                                <!-- V1 структура (старая) -->
                                <StackPanel x:Name="FolderTreeV1">
                                    <!-- Source -->
                                    <StackPanel Margin="20,8,0,0">
                                        <TextBlock Text="📁 source" 
                                                   Foreground="{DynamicResource ForegroundQuaternary}" 
                                                   FontFamily="Consolas" FontSize="12"/>
                                        <StackPanel Margin="20,4,0,0">
                                            <TextBlock Text="📁 maps" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Text="📁 mesh" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Text="📁 dwg" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Text="📁 pln" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Text="📁 pdf" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Text="📁 skp" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Export -->
                                    <StackPanel Margin="20,8,0,0">
                                        <TextBlock Text="📁 export" 
                                                   Foreground="{DynamicResource ForegroundQuaternary}" 
                                                   FontFamily="Consolas" FontSize="12"/>
                                        <StackPanel Margin="20,4,0,0">
                                            <TextBlock Text="📁 HP" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Text="📁 LP" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Work (V1) -->
                                    <StackPanel Margin="20,8,0,0">
                                        <TextBlock Text="📁 work" 
                                                   Foreground="{DynamicResource ForegroundQuaternary}" 
                                                   FontFamily="Consolas" FontSize="12"/>
                                        <StackPanel Margin="20,4,0,0">
                                            <TextBlock Text="📁 texture" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Text="📁 mesh" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Text="📁 bake" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                            <StackPanel Margin="0,4,0,0">
                                                <TextBlock Text="📁 AGR_Check" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                                <StackPanel Margin="20,4,0,0">
                                                    <TextBlock Text="📁 HP" Foreground="{DynamicResource ForegroundDisabled}" FontFamily="Consolas" FontSize="11"/>
                                                    <TextBlock Text="📁 LP" Foreground="{DynamicResource ForegroundDisabled}" FontFamily="Consolas" FontSize="11"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- V2 структура (новая) -->
                                <StackPanel x:Name="FolderTreeV2" Visibility="Collapsed">
                                    <!-- Source -->
                                    <StackPanel Margin="20,8,0,0">
                                        <TextBlock Text="📁 source" 
                                                   Foreground="{DynamicResource ForegroundQuaternary}" 
                                                   FontFamily="Consolas" FontSize="12"/>
                                        <StackPanel Margin="20,4,0,0">
                                            <TextBlock Text="📁 maps" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Text="📁 mesh" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Text="📁 dwg" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Text="📁 pln" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Text="📁 pdf" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Text="📁 skp" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Export (V2) -->
                                    <StackPanel Margin="20,8,0,0">
                                        <TextBlock Text="📁 export" 
                                                   Foreground="{DynamicResource ForegroundQuaternary}" 
                                                   FontFamily="Consolas" FontSize="12"/>
                                        <StackPanel Margin="20,4,0,0">
                                            <TextBlock Text="📁 HP_FBX" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Text="📁 LP_FBX" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Text="📁 GeoJSON" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Text="📁 Archives" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Work (V2) -->
                                    <StackPanel Margin="20,8,0,0">
                                        <TextBlock Text="📁 work" 
                                                   Foreground="{DynamicResource ForegroundQuaternary}" 
                                                   FontFamily="Consolas" FontSize="12"/>
                                        <StackPanel Margin="20,4,0,0">
                                            <!-- Mesh -->
                                            <TextBlock Text="📁 Mesh" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                            <StackPanel Margin="20,4,0,4">
                                                <TextBlock Text="📁 LP_mesh" Foreground="{DynamicResource ForegroundDisabled}" FontFamily="Consolas" FontSize="11"/>
                                                <TextBlock Text="📁 HP_mesh" Foreground="{DynamicResource ForegroundDisabled}" FontFamily="Consolas" FontSize="11"/>
                                            </StackPanel>

                                            <!-- Textures -->
                                            <TextBlock Text="📁 Textures" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>
                                            <StackPanel Margin="20,4,0,4">
                                                <TextBlock Text="📁 HP_textures" Foreground="{DynamicResource ForegroundDisabled}" FontFamily="Consolas" FontSize="10"/>
                                                <StackPanel Margin="20,2,0,2">
                                                    <TextBlock Text="📁 HP_001" Foreground="{DynamicResource ForegroundDisabled}" FontFamily="Consolas" FontSize="9" Opacity="0.7"/>
                                                    <TextBlock Text="📁 HP_002" Foreground="{DynamicResource ForegroundDisabled}" FontFamily="Consolas" FontSize="9" Opacity="0.7"/>
                                                    <TextBlock Text="📁 ..." Foreground="{DynamicResource ForegroundDisabled}" FontFamily="Consolas" FontSize="9" Opacity="0.5"/>
                                                    <TextBlock Text="📁 HP_Ground" Foreground="{DynamicResource ForegroundDisabled}" FontFamily="Consolas" FontSize="9" Opacity="0.7"/>
                                                </StackPanel>

                                                <TextBlock Text="📁 LP_textures" Foreground="{DynamicResource ForegroundDisabled}" FontFamily="Consolas" FontSize="10"/>
                                                <StackPanel Margin="20,2,0,0">
                                                    <TextBlock Text="📁 LP_001" Foreground="{DynamicResource ForegroundDisabled}" FontFamily="Consolas" FontSize="9" Opacity="0.7"/>
                                                    <TextBlock Text="📁 LP_002" Foreground="{DynamicResource ForegroundDisabled}" FontFamily="Consolas" FontSize="9" Opacity="0.7"/>
                                                    <TextBlock Text="📁 ..." Foreground="{DynamicResource ForegroundDisabled}" FontFamily="Consolas" FontSize="9" Opacity="0.5"/>
                                                    <TextBlock Text="📁 LP_Ground" Foreground="{DynamicResource ForegroundDisabled}" FontFamily="Consolas" FontSize="9" Opacity="0.7"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Bake -->
                                            <TextBlock Text="📁 Bake" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11"/>

                                            <!-- AGR_Check -->
                                            <TextBlock Text="📁 AGR_Check" Foreground="{DynamicResource ForegroundTertiary}" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"/>
                                            <StackPanel Margin="20,4,0,0">
                                                <TextBlock Text="📁 HP" Foreground="{DynamicResource ForegroundDisabled}" FontFamily="Consolas" FontSize="11"/>
                                                <TextBlock Text="📁 LP" Foreground="{DynamicResource ForegroundDisabled}" FontFamily="Consolas" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- Описания -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="📋 Описание папок" 
                               Foreground="{DynamicResource ForegroundPrimary}" 
                               FontSize="14" 
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <StackPanel>
                        <!-- Source -->
                        <Border Background="{DynamicResource InfoBoxSourceBackground}" 
                                CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="📂 source" 
                                           Foreground="{DynamicResource InfoBoxSourceForeground}" 
                                           FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="Исходные данные по проекту" 
                                           Foreground="{DynamicResource ForegroundSecondary}" 
                                           FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                <StackPanel Margin="10,8,0,0">
                                    <TextBlock Text="• maps — карты, подложки" Foreground="{DynamicResource ForegroundTertiary}" FontSize="11"/>
                                    <TextBlock Text="• mesh — 3D модели" Foreground="{DynamicResource ForegroundTertiary}" FontSize="11"/>
                                    <TextBlock Text="• dwg — чертежи AutoCAD" Foreground="{DynamicResource ForegroundTertiary}" FontSize="11"/>
                                    <TextBlock Text="• pln — файлы ArchiCAD" Foreground="{DynamicResource ForegroundTertiary}" FontSize="11"/>
                                    <TextBlock Text="• pdf — документация PDF" Foreground="{DynamicResource ForegroundTertiary}" FontSize="11"/>
                                    <TextBlock Text="• skp — файлы SketchUp" Foreground="{DynamicResource ForegroundTertiary}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Export -->
                        <Border Background="{DynamicResource InfoBoxExportBackground}" 
                                CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="📤 export" 
                                           Foreground="{DynamicResource InfoBoxExportForeground}" 
                                           FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="Финальные файлы для отправки" 
                                           Foreground="{DynamicResource ForegroundSecondary}" 
                                           FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                <StackPanel Margin="10,8,0,0">
                                    <TextBlock Text="V1:" Foreground="{DynamicResource ForegroundTertiary}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="• HP — High-Poly модели и архивы" Foreground="{DynamicResource ForegroundTertiary}" FontSize="10" Margin="10,2,0,0"/>
                                    <TextBlock Text="• LP — Low-Poly модели и архивы" Foreground="{DynamicResource ForegroundTertiary}" FontSize="10"/>
                                    <TextBlock Text="V2:" Foreground="{DynamicResource ForegroundTertiary}" FontSize="10" FontWeight="Bold" Margin="0,5,0,0"/>
                                    <TextBlock Text="• HP_FBX — High-Poly FBX файлы" Foreground="{DynamicResource ForegroundTertiary}" FontSize="10" Margin="10,2,0,0"/>
                                    <TextBlock Text="• LP_FBX — Low-Poly FBX файлы" Foreground="{DynamicResource ForegroundTertiary}" FontSize="10"/>
                                    <TextBlock Text="• GeoJSON — Карты GeoJSON" Foreground="{DynamicResource ForegroundTertiary}" FontSize="10"/>
                                    <TextBlock Text="• Archives — Архивы проекта" Foreground="{DynamicResource ForegroundTertiary}" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Work -->
                        <Border Background="{DynamicResource InfoBoxWorkBackground}" 
                                CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🔧 work" 
                                           Foreground="{DynamicResource InfoBoxWorkForeground}" 
                                           FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="Рабочие файлы проекта" 
                                           Foreground="{DynamicResource ForegroundSecondary}" 
                                           FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                <StackPanel Margin="10,8,0,0">
                                    <TextBlock Text="• V1: texture, mesh, bake" Foreground="{DynamicResource ForegroundTertiary}" FontSize="11"/>
                                    <TextBlock Text="• V2: Mesh, Textures, Bake" Foreground="{DynamicResource ForegroundTertiary}" FontSize="11"/>
                                    <TextBlock Text="• AGR_Check — архивы для проверки" Foreground="{DynamicResource ForegroundTertiary}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Выбор рабочей папки -->
        <StackPanel Grid.Row="6">
            <TextBlock Text="Рабочая папка (где будет создана структура)" 
                       Foreground="{DynamicResource ForegroundSecondary}" 
                       FontSize="12" 
                       Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderPathTextBox" 
                         Background="{DynamicResource BackgroundTertiary}" 
                         Foreground="{DynamicResource ForegroundPrimary}" 
                         BorderBrush="{DynamicResource BorderPrimary}"
                         Padding="12,10"
                         FontSize="14"
                         CaretBrush="{DynamicResource ForegroundPrimary}"
                         IsReadOnly="True"/>
                <Button Grid.Column="1" 
                        Content="📂 Выбрать..." 
                        Background="{DynamicResource ButtonBackground}" 
                        Foreground="{DynamicResource ForegroundPrimary}"
                        Padding="15,10"
                        Margin="10,0,0,0"
                        Cursor="Hand"
                        Click="BrowseFolder_Click"/>
            </Grid>
        </StackPanel>

        <!-- Кнопки -->
        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Путь создания -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Будет создано:" 
                           Foreground="{DynamicResource ForegroundDisabled}" 
                           FontSize="11" Margin="0,0,8,0"/>
                <TextBlock x:Name="FullPathPreview" 
                           Text="" 
                           Foreground="{DynamicResource AccentPrimary}" 
                           FontSize="11" 
                           FontFamily="Consolas"
                           MaxWidth="350"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Button Grid.Column="2" 
                    Content="Отмена" 
                    Background="{DynamicResource ButtonBackground}" 
                    Foreground="{DynamicResource ForegroundPrimary}"
                    Padding="25,12"
                    Margin="0,0,10,0"
                    Cursor="Hand"
                    Click="Cancel_Click"/>
            <Button Grid.Column="3" 
                    Content="✨ Создать структуру" 
                    Background="{DynamicResource AccentPrimary}" 
                    Foreground="{DynamicResource ForegroundPrimary}"
                    Padding="25,12"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="Create_Click"/>
        </Grid>
    </Grid>
</Window>
