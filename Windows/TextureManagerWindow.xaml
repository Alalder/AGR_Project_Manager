<Window x:Class="AGR_Project_Manager.Windows.TextureManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="🖼️ Texture Manager" 
        Height="800" Width="1250"
        MinHeight="600" MinWidth="950"
        Background="{DynamicResource BackgroundPrimary}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Стиль для статус-индикатора -->
        <Style x:Key="StatusIndicator" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Цвета выделения -->
        <SolidColorBrush x:Key="SelectedRowBackground" Color="#0078D4"/>
        <SolidColorBrush x:Key="SelectedRowBackgroundInactive" Color="#4D0078D4"/>
        <SolidColorBrush x:Key="WarningRowBackground" Color="#33FFC107"/>
        <SolidColorBrush x:Key="ErrorRowBackground" Color="#33F44336"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Строка 0: Выбор файлов ===== -->
        <Border Grid.Row="0" 
                Background="{DynamicResource BackgroundSecondary}" 
                CornerRadius="8" 
                Padding="12" 
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="📁 Папка:" 
                           Foreground="{DynamicResource ForegroundPrimary}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0,0,10,0"/>

                <TextBox x:Name="FolderPathTextBox" 
                         Grid.Column="1"
                         Background="{DynamicResource BackgroundTertiary}"
                         Foreground="{DynamicResource ForegroundPrimary}"
                         BorderBrush="{DynamicResource BorderPrimary}"
                         Padding="8,6"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"/>

                <Button x:Name="BrowseFilesBtn" 
                        Grid.Column="2"
                        Content="📄 Выбрать файлы..."
                        Background="{DynamicResource AccentPrimary}"
                        Foreground="{DynamicResource ForegroundPrimary}"
                        Padding="12,6"
                        Margin="8,0,0,0"
                        FontWeight="SemiBold"
                        ToolTip="Выбрать отдельные файлы изображений"
                        Click="BrowseFilesBtn_Click"/>

                <Button x:Name="BrowseFolderBtn" 
                        Grid.Column="3"
                        Content="📂 Добавить папку"
                        Background="{DynamicResource ButtonBackground}"
                        Foreground="{DynamicResource ForegroundPrimary}"
                        Padding="12,6"
                        Margin="8,0,0,0"
                        ToolTip="Добавить все изображения из папки"
                        Click="BrowseFolderBtn_Click"/>

                <Button x:Name="ClearListBtn" 
                        Grid.Column="4"
                        Content="🗑️ Очистить"
                        Background="{DynamicResource ButtonBackground}"
                        Foreground="{DynamicResource ForegroundPrimary}"
                        Padding="12,6"
                        Margin="8,0,0,0"
                        ToolTip="Очистить список файлов"
                        Click="ClearListBtn_Click"/>
            </Grid>
        </Border>

        <!-- ===== Строка 1: Статистика ===== -->
        <Border Grid.Row="1" 
                Background="{DynamicResource BackgroundSecondary}" 
                CornerRadius="8" 
                Padding="12" 
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Всего файлов -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="📄 Файлов: " 
                               Foreground="{DynamicResource ForegroundSecondary}"/>
                    <TextBlock x:Name="TotalFilesText" 
                               Text="0" 
                               Foreground="{DynamicResource ForegroundPrimary}"
                               FontWeight="Bold"/>
                </StackPanel>

                <!-- Размер -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="💾 Размер: " 
                               Foreground="{DynamicResource ForegroundSecondary}"/>
                    <TextBlock x:Name="TotalSizeText" 
                               Text="0 B" 
                               Foreground="{DynamicResource ForegroundPrimary}"
                               FontWeight="Bold"/>
                </StackPanel>

                <!-- OK -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Fill="#4CAF50" Style="{StaticResource StatusIndicator}"/>
                    <TextBlock Text="OK: " 
                               Foreground="{DynamicResource ForegroundSecondary}"/>
                    <TextBlock x:Name="OkCountText" 
                               Text="0" 
                               Foreground="#4CAF50"
                               FontWeight="Bold"/>
                </StackPanel>

                <!-- Предупреждения -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Fill="#FFC107" Style="{StaticResource StatusIndicator}"/>
                    <TextBlock Text="Внимание: " 
                               Foreground="{DynamicResource ForegroundSecondary}"/>
                    <TextBlock x:Name="WarningCountText" 
                               Text="0" 
                               Foreground="#FFC107"
                               FontWeight="Bold"/>
                </StackPanel>

                <!-- Ошибки -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Fill="#F44336" Style="{StaticResource StatusIndicator}"/>
                    <TextBlock Text="Ошибки: " 
                               Foreground="{DynamicResource ForegroundSecondary}"/>
                    <TextBlock x:Name="ErrorCountText" 
                               Text="0" 
                               Foreground="#F44336"
                               FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Строка 2: Таблица текстур ===== -->
        <Border Grid.Row="2" 
                Background="{DynamicResource BackgroundSecondary}" 
                CornerRadius="8" 
                Padding="2">
            <DataGrid x:Name="TexturesDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      CanUserSortColumns="True"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      Background="{DynamicResource BackgroundTertiary}"
                      BorderThickness="0"
                      RowHeaderWidth="0">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource BackgroundQuaternary}"/>
                        <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridColumnHeader">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" 
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                            <Path x:Name="SortArrow" 
                                                  Grid.Column="1"
                                                  Visibility="Collapsed"
                                                  Fill="{DynamicResource ForegroundPrimary}"
                                                  Margin="4,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="SortDirection" Value="Ascending">
                                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="SortArrow" Property="Data" Value="M 0 4 L 4 0 L 8 4 Z"/>
                                        </Trigger>
                                        <Trigger Property="SortDirection" Value="Descending">
                                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- Стиль строки с ControlTemplate для гарантированного выделения -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{DynamicResource BackgroundTertiary}"/>
                        <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridRow">
                                    <Border x:Name="DGR_Border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <SelectiveScrollingGrid>
                                            <SelectiveScrollingGrid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </SelectiveScrollingGrid.ColumnDefinitions>
                                            <SelectiveScrollingGrid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </SelectiveScrollingGrid.RowDefinitions>
                                            <DataGridCellsPresenter Grid.Column="1"
                                                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                            <DataGridDetailsPresenter Grid.Column="1"
                                                                      Grid.Row="1"
                                                                      SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                                      Visibility="{TemplateBinding DetailsVisibility}"/>
                                        </SelectiveScrollingGrid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- Warning фон -->
                                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                                            <Setter TargetName="DGR_Border" Property="Background" Value="{StaticResource WarningRowBackground}"/>
                                        </DataTrigger>
                                        <!-- Error фон -->
                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                            <Setter TargetName="DGR_Border" Property="Background" Value="{StaticResource ErrorRowBackground}"/>
                                        </DataTrigger>
                                        <!-- Выделение - наивысший приоритет -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="DGR_Border" Property="Background" Value="{StaticResource SelectedRowBackground}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <!-- Hover эффект (если не выделено) -->
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.RowStyle>

                <!-- Стиль ячейки - прозрачный фон, наследует Foreground от строки -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <!-- Статус -->
                    <DataGridTemplateColumn Header="⚡" Width="35" CanUserSort="True" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="14" Height="14" HorizontalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#4CAF50"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                    <Setter Property="Fill" Value="#FFC107"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                    <Setter Property="Fill" Value="#F44336"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Имя файла -->
                    <DataGridTemplateColumn Header="📄 Имя файла" Width="*" MinWidth="150" CanUserSort="True" SortMemberPath="FileName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}" 
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FilePath}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Разрешение -->
                    <DataGridTemplateColumn Header="📐 Разрешение" Width="110" CanUserSort="True" SortMemberPath="Width">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Resolution}" 
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Битность -->
                    <DataGridTemplateColumn Header="🔢 Биты" Width="70" CanUserSort="True" SortMemberPath="BitsPerChannel">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding BitsDisplay}" 
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Needs8BitConversion}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsIndexed}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Каналы -->
                    <DataGridTemplateColumn Header="🎨 Каналы" Width="75" CanUserSort="True" SortMemberPath="ChannelCount">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ChannelsDisplay}" 
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsIndexed}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Размер файла -->
                    <DataGridTemplateColumn Header="💾 Размер" Width="85" CanUserSort="True" SortMemberPath="FileSize">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileSizeDisplay}" 
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Формат -->
                    <DataGridTemplateColumn Header="📋 Формат" Width="70" CanUserSort="True" SortMemberPath="Format">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Format}" 
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WrongFormat}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Статус/Проблемы -->
                    <DataGridTemplateColumn Header="📝 Статус" Width="220" CanUserSort="True" SortMemberPath="StatusMessage">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusMessage}" 
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ===== Строка 3: Панель действий (одна строка) ===== -->
        <Border Grid.Row="3" 
                Background="{DynamicResource BackgroundSecondary}" 
                CornerRadius="8" 
                Padding="12" 
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Левая часть: основные действия -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🔧 Действия:" 
                               Foreground="{DynamicResource ForegroundSecondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               FontWeight="SemiBold"/>

                    <Button Content="📦 В 8-bit PNG" 
                            Background="{DynamicResource AccentPrimary}"
                            Foreground="{DynamicResource ForegroundPrimary}"
                            Padding="10,6"
                            Margin="0,0,6,0"
                            ToolTip="Конвертировать в 8-bit PNG"
                            Click="ConvertTo8BitPng_Click"/>

                    <Button Content="🚫 Удалить альфа-канал" 
                            Background="{DynamicResource ButtonBackground}"
                            Foreground="{DynamicResource ForegroundPrimary}"
                            Padding="10,6"
                            Margin="0,0,6,0"
                            ToolTip="Удалить альфа-канал (RGBA → RGB)"
                            Click="RemoveAlpha_Click"/>

                    <Button Content="🗜️ Оптимизировать" 
                            Background="{DynamicResource ButtonBackground}"
                            Foreground="{DynamicResource ForegroundPrimary}"
                            Padding="10,6"
                            Margin="0,0,6,0"
                            ToolTip="Максимальное сжатие PNG"
                            Click="OptimizePng_Click"/>

                    <Button Content="🔄 В PNG" 
                            Background="{DynamicResource ButtonBackground}"
                            Foreground="{DynamicResource ForegroundPrimary}"
                            Padding="10,6"
                            ToolTip="Конвертировать в PNG формат"
                            Click="ConvertToPng_Click"/>
                </StackPanel>

                <!-- Разделитель -->
                <Separator Grid.Column="1" 
                           Width="1" 
                           Background="{DynamicResource BorderSecondary}" 
                           Margin="12,0"/>

                <!-- Центральная часть: ресайз -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="📐 Ресайз:" 
                               Foreground="{DynamicResource ForegroundSecondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <ComboBox x:Name="ResizePresetCombo"
                              Width="130"
                              Margin="0,0,6,0"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Выбрать..."/>
                        <ComboBoxItem Content="4096 × 4096" Tag="4096"/>
                        <ComboBoxItem Content="2048 × 2048" Tag="2048"/>
                        <ComboBoxItem Content="1024 × 1024" Tag="1024"/>
                        <ComboBoxItem Content="512 × 512" Tag="512"/>
                        <ComboBoxItem Content="256 × 256" Tag="256"/>
                        <ComboBoxItem Content="128 × 128" Tag="128"/>
                    </ComboBox>

                    <Button Content="📏 Применить" 
                            Background="{DynamicResource ButtonBackground}"
                            Foreground="{DynamicResource ForegroundPrimary}"
                            Padding="10,6"
                            Click="ApplyResize_Click"/>
                </StackPanel>

                <!-- Правая часть: выделение -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Separator Width="1" 
                               Background="{DynamicResource BorderSecondary}" 
                               Margin="12,0"/>

                    <Button Content="✅ Выбрать все" 
                            Background="{DynamicResource ButtonBackground}"
                            Foreground="{DynamicResource ForegroundPrimary}"
                            Padding="10,6"
                            Margin="0,0,6,0"
                            Click="SelectAll_Click"/>

                    <Button Content="❎ Снять" 
                            Background="{DynamicResource ButtonBackground}"
                            Foreground="{DynamicResource ForegroundPrimary}"
                            Padding="10,6"
                            Click="DeselectAll_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Строка 4: Прогресс-бар ===== -->
        <Border Grid.Row="4" 
                Margin="0,10,0,0"
                Visibility="{Binding ElementName=ProgressPanel, Path=Visibility}">
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                <Grid>
                    <ProgressBar x:Name="OperationProgress" 
                                 Height="20" 
                                 Minimum="0" 
                                 Maximum="100"/>
                    <TextBlock x:Name="ProgressText" 
                               Text="0%" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ForegroundPrimary}"
                               FontWeight="SemiBold"/>
                </Grid>
                <TextBlock x:Name="OperationStatusText" 
                           Text="Обработка..." 
                           Foreground="{DynamicResource ForegroundSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>