<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <system:String x:Key="ThemeName" xmlns:system="clr-namespace:System;assembly=mscorlib">Светлая</system:String>

    <!-- ===== ФОНЫ (плотнее, не белёсые — важно для подложки названия тайла с Opacity 0.7) ===== -->
    <SolidColorBrush x:Key="BackgroundPrimary" Color="#dcdcdc"/>
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#cfcfcf"/>
    <SolidColorBrush x:Key="BackgroundTertiary" Color="#f2f2f2"/>
    <SolidColorBrush x:Key="BackgroundQuaternary" Color="#e6e6e6"/>

    <!-- ===== КНОПКИ ===== -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#d4d4d4"/>
    <SolidColorBrush x:Key="ButtonBackgroundHover" Color="#c0c0c0"/>
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#e6e6e6"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#b0b0b0"/>

    <!-- ===== АКЦЕНТЫ ===== -->
    <SolidColorBrush x:Key="AccentPrimary" Color="#3a6a49"/>
    <SolidColorBrush x:Key="AccentSecondary" Color="#4a7c59"/>
    <SolidColorBrush x:Key="AccentTertiary" Color="#2c5238"/>
    <SolidColorBrush x:Key="SelectionBackground" Color="#b8cfe8"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#d8d8e0"/>

    <!-- ===== ТЕКСТ (почти чёрный — держит контраст даже поверх текстур) ===== -->
    <SolidColorBrush x:Key="ForegroundPrimary" Color="#0d0d0d"/>
    <SolidColorBrush x:Key="ForegroundSecondary" Color="#4a4a4a"/>
    <SolidColorBrush x:Key="ForegroundTertiary" Color="#6d6d6d"/>
    <SolidColorBrush x:Key="ForegroundQuaternary" Color="#262626"/>
    <SolidColorBrush x:Key="ForegroundDisabled" Color="#9a9a9a"/>
    <SolidColorBrush x:Key="CodeText" Color="#2c5238"/>

    <!-- ===== ГРАНИЦЫ ===== -->
    <SolidColorBrush x:Key="BorderPrimary" Color="#b8b8b8"/>
    <SolidColorBrush x:Key="BorderSecondary" Color="#a8a8a8"/>
    <SolidColorBrush x:Key="BorderHover" Color="#8a8a8a"/>

    <!-- ===== СПЕЦИАЛЬНЫЕ ===== -->
    <SolidColorBrush x:Key="DangerBackground" Color="#e53935"/>
    <SolidColorBrush x:Key="DangerForeground" Color="#c62828"/>
    <SolidColorBrush x:Key="DangerButtonBackground" Color="#ffcdd2"/>

    <!-- ===== ТЕКСТУРЫ (зоны D/ERM/N) ===== -->
    <SolidColorBrush x:Key="TextureZoneEmpty" Color="#66d0d0d0"/>

    <!-- Diffuse - красный (приглушённый) -->
    <SolidColorBrush x:Key="TextureDiffuse" Color="#e57373"/>
    <SolidColorBrush x:Key="TextureDiffuseHover" Color="#ef9a9a"/>

    <!-- ERM - зелёный (приглушённый) -->
    <SolidColorBrush x:Key="TextureErm" Color="#81c784"/>
    <SolidColorBrush x:Key="TextureErmHover" Color="#a5d6a7"/>

    <!-- Normal - синий (приглушённый) -->
    <SolidColorBrush x:Key="TextureNormal" Color="#7986cb"/>
    <SolidColorBrush x:Key="TextureNormalHover" Color="#9fa8da"/>

    <!-- Акцентные (текстовые) варианты каналов — ярче базовых, для текста поверх тёмного фона зоны -->
    <SolidColorBrush x:Key="TextureDiffuseAccent" Color="#e08a8a"/>
    <SolidColorBrush x:Key="TextureErmAccent" Color="#7fd99a"/>
    <SolidColorBrush x:Key="TextureNormalAccent" Color="#8a9ee0"/>

    <!-- ===== СПИСКИ ===== -->
    <SolidColorBrush x:Key="ListItemBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ListItemBackgroundSelected" Color="#b8cfe8"/>
    <SolidColorBrush x:Key="ListItemBackgroundHover" Color="#d8d8e0"/>

    <!-- ===== COMBOBOX ===== -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#f2f2f2"/>
    <SolidColorBrush x:Key="ComboBoxItemSelected" Color="#3a6a49"/>
    <SolidColorBrush x:Key="ComboBoxItemHighlighted" Color="#dcdcdc"/>
    <SolidColorBrush x:Key="ComboBoxArrow" Color="#4a4a4a"/>

    <!-- ===== ИНФОРМАЦИОННЫЕ БЛОКИ ===== -->
    <SolidColorBrush x:Key="InfoBoxSourceBackground" Color="#e8f5e9"/>
    <SolidColorBrush x:Key="InfoBoxSourceForeground" Color="#2e7d32"/>

    <SolidColorBrush x:Key="InfoBoxExportBackground" Color="#fff8e1"/>
    <SolidColorBrush x:Key="InfoBoxExportForeground" Color="#f9a825"/>

    <SolidColorBrush x:Key="InfoBoxWorkBackground" Color="#e3f2fd"/>
    <SolidColorBrush x:Key="InfoBoxWorkForeground" Color="#1565c0"/>

    <SolidColorBrush x:Key="InfoBoxCheckBackground" Color="#ffebee"/>
    <SolidColorBrush x:Key="InfoBoxCheckForeground" Color="#c62828"/>

    <!-- ===== ДОПОЛНИТЕЛЬНЫЕ КНОПКИ ===== -->
    <SolidColorBrush x:Key="ButtonDanger" Color="#7c4a4a"/>
    <SolidColorBrush x:Key="ButtonInfo" Color="#3a3a5a"/>

    <!-- ===== ЦВЕТОВЫЕ КАНАЛЫ RGB ===== -->
    <SolidColorBrush x:Key="ColorChannelRed" Color="#ff6b6b"/>
    <SolidColorBrush x:Key="ColorChannelGreen" Color="#6bff6b"/>
    <SolidColorBrush x:Key="ColorChannelBlue" Color="#6b6bff"/>

    <!-- ===== СЕКЦИИ СПРАВКИ ===== -->
    <SolidColorBrush x:Key="HelpSectionProjects" Color="#2e7d32"/>
    <SolidColorBrush x:Key="HelpSectionModels" Color="#1565c0"/>
    <SolidColorBrush x:Key="HelpSectionUdim" Color="#f9a825"/>
    <SolidColorBrush x:Key="HelpSectionPresets" Color="#0097a7"/>
    <SolidColorBrush x:Key="HelpSectionExport" Color="#c2185b"/>
    <SolidColorBrush x:Key="HelpSectionUtilities" Color="#7b1fa2"/>
    <SolidColorBrush x:Key="HelpSectionHotkeys" Color="#00897b"/>
    <SolidColorBrush x:Key="HelpSectionStorage" Color="#fbc02d"/>

    <!-- ===== БЛОКИ СПРАВКИ ===== -->
    <SolidColorBrush x:Key="HelpBoxPurple" Color="#ede7f6"/>
    <SolidColorBrush x:Key="HelpBoxGreen" Color="#e8f5e9"/>
    <SolidColorBrush x:Key="HelpBoxRed" Color="#ffebee"/>
    <SolidColorBrush x:Key="HelpBoxBlue" Color="#e3f2fd"/>

    <!-- ===== СТАТУСНЫЕ ЦВЕТА ===== -->
    <SolidColorBrush x:Key="SuccessText" Color="#2e7d32"/>

    <!-- ===== ИНДИКАТОРЫ РАЗРЕШЕНИЯ ТЕКСТУР ===== -->
    <SolidColorBrush x:Key="Resolution4K" Color="#10b981"/>
    <SolidColorBrush x:Key="Resolution2K" Color="#3b82f6"/>
    <SolidColorBrush x:Key="Resolution1K" Color="#f59e0b"/>
    <SolidColorBrush x:Key="Resolution512" Color="#f59e0b"/>
    <SolidColorBrush x:Key="Resolution256" Color="#ef4444"/>

</ResourceDictionary>